# Public values, inlined into the static build (Astro exposes only PUBLIC_*).
# The contact form falls back to the production Turnstile key and email Worker
# when these are empty; set them only to point at a different setup.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_EMAIL_API_ENDPOINT=
PUBLIC_UMAMI_WEBSITE_ID=
# GitHub stats need no key: they come from public endpoints and refresh in the
# visitor's browser (cached 6 h in localStorage).
