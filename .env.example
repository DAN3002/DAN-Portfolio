# Public values, inlined into the static build (Astro exposes only PUBLIC_*).
# The contact form falls back to the production Turnstile key and email Worker
# when these are empty; set them only to point at a different setup.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_EMAIL_API_ENDPOINT=
PUBLIC_UMAMI_WEBSITE_ID=
# Recommended: a GitHub token (fine-grained, public read-only is enough) for the
# build-time stats. With it: all-time contributions and commits (incl. private
# contributions shown on your profile), PRs and the contribution graph. Without
# it: public-only commit count and no graph. Locally: GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=
