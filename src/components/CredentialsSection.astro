---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { certifications, courses } from '~/data/credentials';

const courseCount = courses.reduce((n, g) => n + g.items.length, 0);
---

<Section id="credentials" title="Credentials">
	<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{certifications.map((c) => (
			<li class="group card relative flex items-center gap-4 p-4 transition-colors hover:border-ink" data-reveal>
				<Image src={c.image} alt="" width={192} format="webp" densities={[1, 2]} loading="lazy" class="h-16 w-24 shrink-0 rounded-lg object-contain" />
				<div class="min-w-0">
					<h3 class="font-display leading-snug font-semibold">
						<a href={c.url} target="_blank" rel="noopener" class="after:absolute after:inset-0" data-track="view-cert" data-track-name={c.name}>
							{c.name}
						</a>
					</h3>
					<p class="mt-1 flex items-center gap-1 text-xs text-muted">
						Issued {c.issued} · Verify on Credly
						<Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" />
					</p>
				</div>
			</li>
		))}
	</ul>

	<details class="group card mt-10">
		<summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 font-medium [&::-webkit-details-marker]:hidden">
			<span>{courseCount} completed courses, by topic</span>
			<Icon name="lucide:chevron-down" class="size-5 text-muted transition-transform group-open:rotate-180" aria-hidden="true" />
		</summary>
		<div class="grid gap-8 border-t border-line p-5 sm:grid-cols-2">
			{courses.map((g) => (
				<div>
					<h3 class="eyebrow mb-3">{g.topic}</h3>
					<ul class="space-y-2">
						{g.items.map((c) => (
							<li>
								<a href={c.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm hover:text-accent hover:underline sm:min-h-0">{c.name}</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</details>
</Section>
