---
import { Icon } from 'astro-icon/components';
import { site } from '~/data/site';
import { getLastUpdated } from '~/lib/github';

const lastUpdated = await getLastUpdated();
// "Updated" = last commit to this repo, i.e. when the content last changed.
const updated = lastUpdated.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<footer class="border-t border-line py-10">
	<div class="container-page flex flex-col items-start justify-between gap-6 text-sm text-muted sm:flex-row sm:items-center">
		<p>© {new Date().getFullYear()} {site.name}. Updated <time datetime={lastUpdated.toISOString()}>{updated}</time>.</p>
		<div class="flex items-center gap-4">
			<a href="https://github.com/DAN3002/DAN-Portfolio" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 hover:text-ink">
				<Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
				Source
			</a>
			<a href="#top" class="inline-flex min-h-11 items-center gap-1.5 hover:text-ink">
				Back to top
				<Icon name="lucide:arrow-up-right" class="size-4 -rotate-45" aria-hidden="true" />
			</a>
		</div>
	</div>
</footer>
