---
import { Icon } from 'astro-icon/components';
import { getGithubStats, compact, toCells, GITHUB_USER } from '~/lib/github';

const gh = await getGithubStats();
const profile = `https://github.com/${GITHUB_USER}`;

// Fixed slots, so a live refresh only swaps text and never reflows the card.
const stats = [
	{ key: 'contributions', label: 'Contributions', value: gh.contributions, hint: gh.since ? `since ${gh.since}` : undefined },
	{ key: 'commits', label: 'Public commits', value: gh.commits },
	{ key: 'repos', label: 'Repositories', value: gh.repos },
	{ key: 'stars', label: 'Stars earned', value: gh.stars },
] as const;

const cells = toCells(gh.lastYear?.days ?? []);
const weeks = Math.ceil(cells.length / 7);
const total = gh.lastYear?.total.toLocaleString('en');
const fmt = (d: string) =>
	new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
// Seed the browser refresh with exactly what was rendered.
const snapshot = JSON.stringify(gh);
---

<section class="card p-4 sm:p-6" aria-labelledby="gh-title" data-gh-card data-gh-snapshot={snapshot}>
	<div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
		<h2 id="gh-title" class="eyebrow">GitHub activity</h2>
		<a href={profile} target="_blank" rel="noopener" class="-my-2 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium hover:text-accent">
			<Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
			@{GITHUB_USER}
			<Icon name="lucide:arrow-up-right" class="size-3.5 text-muted" aria-hidden="true" />
		</a>
	</div>

	<div class="grid gap-5 lg:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] lg:items-center lg:gap-8">
	<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-line sm:grid-cols-4 lg:grid-cols-2">
		{stats.map((s) => (
			<div class="bg-surface px-3.5 py-3">
				<dt class="text-xs text-muted">{s.label}</dt>
				<dd class="font-display text-2xl font-semibold tabular-nums" data-gh-stat={s.key} title={s.value?.toLocaleString('en')}>
					{s.value === null ? '—' : compact(s.value)}
				</dd>
				{'hint' in s && s.hint && <dd class="text-xs text-muted">{s.hint}</dd>}
			</div>
		))}
	</dl>

	{cells.length > 0 && (
		<figure class="min-w-0">
			<div class="gh-graph-clip">
			{/* Fluid grid: 7 rows, one column per week; cells scale with the card, never scroll. */}
			{/* Cells cap at 13px on wide screens; on phones the oldest weeks are clipped
			    from the left (see .gh-graph), keeping the recent half-year readable. */}
			<div
				class="gh-graph grid grid-flow-col grid-rows-7 gap-[3px]"
				style={`--weeks: ${weeks}; grid-template-columns: repeat(${weeks}, minmax(0, 1fr));`}
				role="img"
				aria-label={`Contribution graph: ${total} contributions in the last year`}
				data-gh-graph
			>
				{cells.map((d) =>
					d ? (
						<span class="gh-cell aspect-square rounded-[2px]" data-level={d.level} title={`${d.count} contribution${d.count === 1 ? '' : 's'} on ${fmt(d.date)}`}></span>
					) : (
						<span></span>
					),
				)}
			</div>
			</div>
			<figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs text-muted">
				<span>
					<span class="font-medium text-ink tabular-nums" data-gh-year-total>{total}</span> contributions in the last year<span class="sm:hidden"> (last 6 months shown)</span>
					<span aria-hidden="true">·</span>
					updated <time datetime={gh.fetchedAt} data-gh-fetched>at build</time>
				</span>
				<span class="flex items-center gap-1" aria-hidden="true">
					Less
					{[0, 1, 2, 3, 4].map((l) => <span class="gh-cell size-2.5 rounded-[2px]" data-level={l}></span>)}
					More
				</span>
			</figcaption>
		</figure>
	)}
	</div>
</section>

<style is:global>
	.gh-graph {
		/* At most 13px cells + 3px gaps, so the year never stretches past ~850px. */
		max-width: calc(var(--weeks) * 16px);
		margin-inline-start: auto;
	}
	@media (max-width: 39.99rem) {
		/* Phones: show the newest 26 weeks at a readable size instead of 53 tiny ones. */
		.gh-graph {
			width: calc(var(--weeks) / 26 * 100%);
			max-width: none;
			margin-left: calc((26 - var(--weeks)) / 26 * 100%);
		}
		.gh-graph-clip {
			overflow: hidden;
		}
	}

	/* Global: cells are also created by the live refresh script. */
	.gh-cell[data-level='0'] { background: var(--line); }
	.gh-cell[data-level='1'] { background: color-mix(in oklab, var(--accent) 30%, var(--surface)); }
	.gh-cell[data-level='2'] { background: color-mix(in oklab, var(--accent) 55%, var(--surface)); }
	.gh-cell[data-level='3'] { background: color-mix(in oklab, var(--accent) 78%, var(--surface)); }
	.gh-cell[data-level='4'] { background: var(--accent); }
</style>

<script>
	import { initGithubLive } from '~/lib/github-live';

	const card = document.querySelector<HTMLElement>('[data-gh-card]');
	if (card) {
		// Refresh off the critical path: after load, when the browser is idle.
		const start = () => void initGithubLive(card);
		if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 });
		else setTimeout(start, 1500);
	}
</script>
