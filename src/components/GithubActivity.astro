---
import { Icon } from 'astro-icon/components';
import { compact, toCells, monthLabels, describeCalendar, cellTitle, GITHUB_USER } from '~/lib/github';
import { getGithubStats } from '~/lib/github-build';

const gh = await getGithubStats();
const profile = `https://github.com/${GITHUB_USER}`;

// Fixed slots, so a live refresh only swaps text and never reflows the card.
const stats = [
	{ key: 'contributions', label: 'Contributions', value: gh?.contributions ?? null, since: true },
	{ key: 'commits', label: 'Public commits', value: gh?.commits ?? null },
	{ key: 'repos', label: 'Repositories', value: gh?.repos ?? null },
	{ key: 'stars', label: 'Stars earned', value: gh?.stars ?? null },
];

const cal = gh?.lastYear ?? null;
const cells = toCells(cal);
const weeks = Math.max(1, Math.ceil(cells.length / 7));
const months = monthLabels(cells);
const cols = `grid-template-columns: repeat(${weeks}, minmax(0, 1fr));`;
// Seed the browser refresh with exactly what was rendered (compact form, ~3 KB).
const snapshot = gh ? JSON.stringify(gh) : 'null';
---

<section class="card p-4 sm:p-5" aria-labelledby="gh-title" data-gh-card data-gh-snapshot={snapshot}>
	<div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
		<h2 id="gh-title" class="eyebrow">GitHub activity</h2>
		<a href={profile} target="_blank" rel="noopener" class="-my-2 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium hover:text-accent">
			<Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
			@{GITHUB_USER}
			<Icon name="lucide:arrow-up-right" class="size-3.5 text-muted" aria-hidden="true" />
		</a>
	</div>

	<div class="grid gap-5 lg:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] lg:items-center lg:gap-8">
		<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-line sm:grid-cols-4 lg:grid-cols-2">
			{stats.map((s) => (
				<div class="bg-surface px-3.5 py-3">
					<dt class="text-xs text-muted">{s.label}</dt>
					<dd class="font-display text-2xl font-semibold tabular-nums" data-gh-stat={s.key} title={s.value?.toLocaleString('en')}>
						{s.value === null ? '—' : compact(s.value)}
					</dd>
					{s.since && <dd class="text-xs text-muted" data-gh-since>{gh?.since ? `since ${gh.since}` : ''}</dd>}
				</div>
			))}
		</dl>

		<figure class="min-w-0">
			{/* Always rendered, so a live refresh can fill it even if the build fetch failed. */}
			<div class="gh-wrap overflow-hidden" style={`--weeks: ${weeks};`} hidden={!cal} data-gh-wrap>
				<div class="gh-scale">
					<div class="mb-1 grid text-[11px] leading-none text-muted" style={cols} aria-hidden="true" data-gh-months>
						{months.map((m) => <span class="whitespace-nowrap">{m}</span>)}
					</div>
					<div class="grid grid-flow-col grid-rows-7 gap-[3px]" style={cols} role="img" aria-label={describeCalendar(cal)} data-gh-graph>
						{cells.map((d) => (d ? <span class="gh-cell" data-level={d.level} title={cellTitle(d)}></span> : <span></span>))}
					</div>
				</div>
			</div>
			<p class="grid h-[7.5rem] place-items-center rounded-lg border border-dashed border-line text-sm text-muted" hidden={!!cal} data-gh-empty>
				The contribution graph couldn't load. See it on GitHub.
			</p>
			<figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs text-muted">
				<span>
					<span class="font-medium text-ink tabular-nums" data-gh-year-total>{cal?.total.toLocaleString('en') ?? '—'}</span> contributions in the last year<span class="sm:hidden"> (latest 6 months shown)</span>
					<span aria-hidden="true">·</span>
					updated <time datetime={gh?.fetchedAt} data-gh-fetched>at build</time>
				</span>
				<span class="flex items-center gap-1" aria-hidden="true">
					Less
					{[0, 1, 2, 3, 4].map((l) => <span class="gh-cell size-2.5" data-level={l}></span>)}
					More
				</span>
			</figcaption>
		</figure>
	</div>
</section>

<style is:global>
	/* Global: cells and labels are also created by the live refresh script. */
	.gh-scale {
		/* At most 13px cells + 3px gaps, so the year never stretches past ~850px. */
		max-width: calc(var(--weeks) * 16px);
		margin-inline-start: auto;
	}
	@media (max-width: 39.99rem) {
		/* Phones: newest 26 weeks at a readable size instead of 53 tiny ones. */
		.gh-scale {
			width: calc(var(--weeks) / 26 * 100%);
			max-width: none;
			margin-inline-start: calc((26 - var(--weeks)) / 26 * 100%);
		}
	}
	.gh-cell {
		aspect-ratio: 1;
		border-radius: 2px;
		/* Hairline edge so empty and low days stay distinguishable (WCAG 1.4.11). */
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
	}
	.dark .gh-cell {
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
	}
	/* Heat scale from the accent colour, spaced further apart than GitHub's. */
	.gh-cell[data-level='0'] { background: var(--line); }
	.gh-cell[data-level='1'] { background: color-mix(in oklab, var(--accent) 42%, var(--surface)); }
	.gh-cell[data-level='2'] { background: color-mix(in oklab, var(--accent) 64%, var(--surface)); }
	.gh-cell[data-level='3'] { background: color-mix(in oklab, var(--accent) 84%, var(--surface)); }
	.gh-cell[data-level='4'] { background: var(--accent); }
</style>

<script>
	import { initGithubLive } from '~/lib/github-live';

	const card = document.querySelector<HTMLElement>('[data-gh-card]');
	if (card) {
		// Refresh off the critical path: after load, when the browser is idle.
		const start = () => void initGithubLive(card);
		if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 });
		else setTimeout(start, 1500);
	}
</script>
