---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '~/data/site';
import { pictureFormats, fallbackFormat, slots } from '~/lib/images';
import GithubActivity from './GithubActivity.astro';
---

<section id="top" class="relative overflow-hidden" aria-labelledby="hero-title">
	<!-- Faint grid, a nod to infrastructure diagrams. Decorative only. -->
	<div
		class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top,black,transparent_70%)] opacity-60 dark:opacity-40"
		style="background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px;"
		aria-hidden="true"
	>
	</div>

	<div class="container-page grid items-center gap-x-16 gap-y-10 pt-14 pb-20 md:pt-20 md:pb-24 lg:grid-cols-[1.5fr_1fr]">
		<div>
			<p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface py-1 pr-3 pl-1.5 text-sm">
				<span class="relative flex size-2.5 items-center justify-center pl-4" aria-hidden="true">
					<span class="absolute size-2.5 animate-ping rounded-full bg-ok opacity-60 motion-reduce:animate-none"></span>
					<span class="relative size-2 rounded-full bg-ok"></span>
				</span>
				Now at <a href="#now" aria-label="Now at Drylab: see current work" class="font-medium underline decoration-line underline-offset-4 hover:decoration-ink">Drylab</a>
			</p>

			<h1 id="hero-title" class="text-4xl leading-[1.05] font-semibold sm:text-5xl lg:text-6xl">
				I build the platforms <span class="text-accent">other engineers ship on.</span>
			</h1>

			<p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
				I'm <strong class="font-semibold text-ink">{site.name}</strong>, a DevOps and software engineer in Hà Nội.
				I started university at 16, became VPBank's youngest Senior Specialist at 21, and now work on the platform
				behind Drylab's AI for biomedical research.
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a href="#projects" class="btn-primary">
					See my work
					<Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
				</a>
				<a href={`mailto:${site.email}`} class="btn-ghost">
					<Icon name="lucide:mail" class="size-4" aria-hidden="true" />
					{site.email}
				</a>
			</div>

			<ul class="mt-8 flex items-center gap-1" aria-label="Elsewhere">
				{site.socials.map((s) => (
					<li>
						<a href={s.href} target="_blank" rel="noopener" class="grid size-11 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-ink" aria-label={s.label}>
							<Icon name={s.icon} class="size-5" aria-hidden="true" />
						</a>
					</li>
				))}
			</ul>
		</div>

		<div class="mx-auto w-full max-w-sm lg:max-w-none">
			<div class="card overflow-hidden p-2 shadow-[0_24px_60px_-24px_rgb(15_23_40/0.35)]">
				<Picture
					src={site.profile}
					alt={`Portrait of ${site.name}`}
					formats={[...pictureFormats]}
					fallbackFormat={fallbackFormat}
					widths={[...slots.hero.widths]}
					sizes={slots.hero.sizes}
					loading="eager"
					fetchpriority="high"
					class="aspect-square w-full rounded-xl object-cover"
				/>
			</div>
		</div>

		{/* Full width right under the intro + portrait, so the year graph has room to read. */}
		<div class="lg:col-span-2">
			<GithubActivity />
		</div>
	</div>
</section>
