---
import { Icon } from 'astro-icon/components';
import Section from './Section.astro';
import { currentWork as w } from '~/data/career';
---

<Section id="now" eyebrow={`Since ${w.since}`} title={`Now: ${w.role} at ${w.company}`} intro={w.tagline}>
	<div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-12">
		<!-- Click-to-load video: the YouTube player (~1 MB of JS) loads only on demand. -->
		<div class="card overflow-hidden" data-reveal>
			<div class="relative aspect-video bg-ink" data-yt={w.videoId} data-yt-title={w.videoTitle}>
				<button type="button" class="group absolute inset-0 grid place-items-center" aria-label={`Play video: ${w.videoTitle}`}>
					<img
						src={`https://i.ytimg.com/vi/${w.videoId}/hqdefault.jpg`}
						alt=""
						loading="lazy"
						decoding="async"
						width="480"
						height="360"
						class="absolute inset-0 size-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
					/>
					<span class="relative grid size-16 place-items-center rounded-full bg-paper/95 text-ink shadow-lg transition-transform group-hover:scale-105">
						<Icon name="lucide:play" class="ml-1 size-7" aria-hidden="true" />
					</span>
				</button>
			</div>
		</div>

		<div data-reveal>
			<p class="text-lg leading-relaxed">{w.description}</p>
			<div class="mt-6 flex flex-wrap gap-3">
				<a href={w.url} target="_blank" rel="noopener" class="btn-ghost" data-track="current-work-link" data-track-type="website">
					thedrylab.com
					<Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
				</a>
				<a href={w.linkedin} target="_blank" rel="noopener" class="btn-ghost" data-track="current-work-link" data-track-type="linkedin">
					<Icon name="simple-icons:linkedin" class="size-4" aria-hidden="true" />
					Drylab on LinkedIn
				</a>
			</div>
		</div>
	</div>

	<ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		{w.highlights.map((h) => (
			<li class="card p-5" data-reveal>
				<span class="mb-4 grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
					<Icon name={h.icon} class="size-5" aria-hidden="true" />
				</span>
				<h3 class="font-display text-lg font-semibold">{h.title}</h3>
				<p class="mt-1 text-sm leading-relaxed text-muted">{h.text}</p>
			</li>
		))}
	</ul>
</Section>

<script>
	document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
		box.querySelector('button')?.addEventListener('click', () => {
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0&modestbranding=1`;
			iframe.title = box.dataset.ytTitle ?? 'Video';
			iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			iframe.allowFullscreen = true;
			iframe.className = 'absolute inset-0 size-full';
			box.replaceChildren(iframe);
			iframe.focus();
		});
	});
</script>
