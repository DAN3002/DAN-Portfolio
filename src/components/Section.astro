---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	intro?: string;
	class?: string;
}
const { id, eyebrow, title, intro, class: className = '' } = Astro.props;
---

<section id={id} class:list={['py-20 md:py-28', className]} aria-labelledby={`${id}-title`}>
	<div class="container-page">
		<header class="mb-10 max-w-2xl md:mb-14" data-reveal>
			<p class="eyebrow mb-3">{eyebrow}</p>
			<h2 id={`${id}-title`} class="text-3xl font-semibold sm:text-4xl">{title}</h2>
			{intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
		</header>
		<slot />
	</div>
</section>
