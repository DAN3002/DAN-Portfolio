---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Nguyễn Đình Anh">
	<main id="main" class="container-page grid min-h-dvh place-items-center text-center">
		<div>
			<p class="eyebrow">404</p>
			<h1 class="mt-3 text-4xl font-semibold">This page doesn't exist</h1>
			<p class="mt-3 text-muted">The link may be old. Everything lives on the home page now.</p>
			<a href="/" class="btn-primary mt-8">Go to the home page</a>
		</div>
	</main>
</BaseLayout>
